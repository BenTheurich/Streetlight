{
  "name": "streetlight-web",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm db:migrate && pnpm db:seed && next dev -p 3000",
    "postinstall": "playwright install chromium",
    "build": "next build",
    "start": "next start -p 3000",
    "lint": "biome check .",
    "test": "node --experimental-strip-types --import ./test/register-tsx.mjs --test \"{app,components,db,lib}/**/*.test.{ts,mjs}\" \"*.test.mjs\"",
    "db:migrate": "node db/migrate.mjs",
    "db:seed": "node db/seed.mjs",
    "coverage:demo": "node db/seed-coverage-demo.mjs --serve",
    "progress:demo": "node db/seed-outreach-progress-demo.mjs --serve",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@next/env": "16.3.0",
    "@radix-ui/react-select": "^2.3.7",
    "@workos-inc/authkit-nextjs": "^4.3.0",
    "@workos-inc/node": "^10.8.0",
    "maplibre-gl": "^5.24.0",
    "next": "16.3.0",
    "pdf-lib": "^1.17.1",
    "playwright": "1.62.0",
    "qrcode": "^1.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.5",
    "@types/google.maps": "^3.65.3",
    "@types/node": "22.20.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "typescript": "5.9.3"
  }
}
