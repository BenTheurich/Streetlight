{
  "name": "streetlight-web",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm db:migrate && pnpm db:seed && next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "lint": "biome check .",
    "test": "node --experimental-strip-types --test db/database.test.mjs lib/google-maps-server.test.ts lib/territory-client.test.ts lib/territory-geometry.test.ts lib/territory.test.ts",
    "db:migrate": "node db/migrate.mjs",
    "db:seed": "node db/seed.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "next": "16.2.11",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.5",
    "@types/google.maps": "^3.65.3",
    "@types/node": "22.20.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "typescript": "5.9.3"
  }
}
